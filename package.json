{
  "name": "live-monitor-desktop",
  "version": "0.4.14",
  "private": true,
  "description": "直播监测桌面工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "cn.live.monitor",
    "productName": "直播监测",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "node_modules/sql.js/**/*",
      "package.json",
      "src/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "vendor/hermes-runtime",
        "to": "hermes-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "electron/hermes-worker.py",
        "to": "hermes-worker.py"
      }
    ]
  },
  "author": "Live Monitor"
}
